# NCA's image. One image runs the web server ("web"), the job runner
# ("workers"), and one-off commands ("cli").
#
# Targets:
#
# - production (the default): compiled binaries, templates, and static files
# - dev: production's runtime plus Go. The source tree gets bind-mounted over
#   /usr/local/nca (see compose.override.example.yml), and the entrypoint
#   recompiles whatever it's asked to run, so restarting a container picks up
#   code changes.
#
# Configuration: /etc/nca/settings is settings-example, verbatim. Everything
# environment-specific is set via NCA_* environment variables (see compose.yml
# and .env.example), which override the file's values.

ARG GO_IMAGE=docker.io/library/golang:1.26

###
# Go toolchain, used by "build" and copied into "dev"
###
FROM ${GO_IMAGE} AS go

###
# Runtime dependencies shared by "production" and "dev"
###
FROM docker.io/library/rockylinux:9 AS base

RUN dnf install -y 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled crb && \
    dnf install -y epel-release && \
    dnf upgrade --refresh -y && \
    dnf install -y poppler-utils openjpeg2-tools GraphicsMagick ghostscript mariadb jq && \
    dnf clean all

WORKDIR /usr/local/nca

# Lock dir for the entrypoint (backed by a volume shared by all NCA services)
RUN mkdir -p /var/local/nca/locks /var/local/news/nca/cache

ENV NCA_CONFIG=/etc/nca/settings
ENV PATH=/usr/local/nca/bin:$PATH

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["server"]

###
# Compile all NCA binaries
###
FROM go AS build

WORKDIR /usr/local/src/nca

# Dependencies first, so code changes don't mean re-downloading everything
COPY ./go.mod ./go.sum ./
RUN go mod download

COPY ./Makefile ./
COPY ./scripts ./scripts
COPY ./internal ./internal
COPY ./src ./src

# Static binaries: the runtime image's libc isn't the build image's libc.
# BUILD is NCA's version string (the Makefile normally gets it from git, which
# isn't in the build context).
ARG NCA_VERSION=unknown
ENV CGO_ENABLED=0
RUN make fast BUILD=$NCA_VERSION

###
# Dev: production's runtime plus Go, git, and make. The source isn't copied
# in; it's expected to be bind-mounted at /usr/local/nca.
###
FROM base AS dev

RUN dnf install -y git make && dnf clean all

COPY --from=go /usr/local/go /usr/local/go

# Both Go caches live under /root/.cache so one volume can persist them
ENV PATH=/usr/local/nca/bin:/usr/local/go/bin:$PATH
ENV CGO_ENABLED=0
ENV GOCACHE=/root/.cache/go-build
ENV GOMODCACHE=/root/.cache/go-mod
ENV GOTOOLCHAIN=local

# Config and scripts go last in each final stage, since they change the most
COPY ./settings-example /etc/nca/settings
COPY ./docker/entrypoint.sh ./docker/wait-for-db /usr/local/bin/

###
# Production (default target): the compiled app
###
FROM base AS production

COPY --from=build /usr/local/src/nca/bin ./bin
COPY ./static ./static
COPY ./templates ./templates
COPY ./settings-example /etc/nca/settings
COPY ./docker/entrypoint.sh ./docker/wait-for-db /usr/local/bin/
