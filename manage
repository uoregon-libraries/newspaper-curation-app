#!/usr/bin/env bash
#
# Snapshots for dev and testing: back up or restore the whole dev stack's
# state (test/fakemount plus the stack's volumes), or wipe it. Backups live in
# ./backup/<name>. Requires rootless podman; see scripts/localdev.sh.
set -eu

cd "$(dirname "$0")"
source ./scripts/localdev.sh

PROJECT=$(_nca_project)

# Volumes that aren't stack state: Go's caches and the dev image's binaries
SKIP_VOLUMES="go-cache dev-bin"

# Prints the stack's volumes (compose names, e.g., "db") holding data we
# snapshot: everything compose created except the skipped volumes and those
# bound to host directories, which live in test/fakemount
data_volumes() {
  local vol name
  for vol in $(podman volume ls -q --filter "label=io.podman.compose.project=$PROJECT"); do
    name=${vol#"${PROJECT}_"}
    if [[ " $SKIP_VOLUMES " == *" $name "* ]]; then
      continue
    fi
    if [[ $(podman volume inspect --format '{{index .Options "o"}}' "$vol") == "bind" ]]; then
      continue
    fi
    echo "$name"
  done
}

nuke() {
  echo "Deleting the stack"
  nca_compose down
  # shellcheck disable=SC2046
  _nca_rm_volumes $(data_volumes)
  podman unshare rm -rf ./test/fakemount
  echo "Done (Deleting the stack)"
}

backup() {
  local dir=$1 vol

  # Make sure every volume exists so the backup is complete
  _nca_host_dirs
  nca_compose up --no-start

  echo "Taking down the stack gracefully"
  nca_compose down

  mkdir -p "$dir"
  rm -f "$dir"/*.tar

  echo "Writing fakemount backup"
  podman unshare tar -cpf "$dir/fakemount.tar" ./test/fakemount

  echo "Backing up volumes..."
  for vol in $(data_volumes); do
    echo "  - $vol"
    podman volume export "${PROJECT}_$vol" --output "$dir/volume-$vol.tar"
  done
  echo "Done (Backing up to $dir)"

  nca_up
}

restore() {
  local dir=$1 tarfile vol

  nuke

  echo "Restoring from $dir"
  podman unshare tar -xpf "$dir/fakemount.tar"

  for tarfile in "$dir"/volume-*.tar; do
    vol=${tarfile##*/volume-}
    vol=${vol%.tar}
    echo "  - $vol"
    podman volume create --label "io.podman.compose.project=$PROJECT" "${PROJECT}_$vol" >/dev/null
    podman volume import "${PROJECT}_$vol" "$tarfile"
  done
  echo "Done (Restoring from $dir)"

  nca_up
}

reset() {
  echo "Resetting the stack"
  nca_compose build
  resetdb
  resetfakemount
  echo "Done (Resetting the stack)"
}

dir="./backup/${2:-default}"

case ${1:-} in
reset)
  reset
  ;;

build)
  nca_compose build
  ;;

nuke)
  nuke
  ;;

backup)
  echo "Backing up to \"$dir\" in two seconds...."
  sleep 2
  backup "$dir"
  ;;

restore)
  sec=2
  dir=$(realpath "$dir")
  if [[ ! -d $dir ]]; then
    dirname=${dir%/*}
    wildcard="${dir##*/}*"
    dir=$(find "$dirname" -mindepth 1 -maxdepth 1 -type d -name "$wildcard")
    sec=5
  fi
  echo "Restoring from \"$dir\" in $sec seconds...."
  sleep $sec
  restore "$dir"
  ;;

migrate)
  migrate
  ;;

*)
  echo "Usage: ./manage <reset|build|nuke|backup|restore|migrate> [backup name]"
  ;;
esac
