# Copy this file to `.env` and edit it. The stack refuses to start without it.
#
# These values are for dev, so dev is easy to stand up and production has to
# be set up deliberately. Keep it that way when adding settings.
#
# Variables exported in your shell silently override this file, so watch for
# collisions (e.g., an old DB_PASSWORD from some other project).

##
# Compose project
##

# Prefixes every container, network, and volume name (e.g., nca_db). Change it
# to run more than one stack at once (e.g., git worktrees), and in production,
# where the checkout's directory name might not be meaningful (our pattern of
# `/srv/<projectname>/app` or `.../repo` or whatever). Changing it later
# orphans the old volumes rather than renaming them.
#
# A second dev stack also needs its own host ports: change PUBLIC_PORT and the
# other *_PORT settings below.
COMPOSE_PROJECT_NAME=nca

##
# Compose profiles
##

# - local-dev: staging and production ONI stacks for NCA to load batches into.
#   NEVER enable this in production!
# - sftpgo: SFTPGo for publisher uploads, if it isn't run elsewhere
#
# Don't add "tools" here; it's for the "cli" service, which you run with an
# explicit --profile flag.
COMPOSE_PROFILES=local-dev,sftpgo

##
# Container logs
##

# Where each service writes its stdout/stderr (web.log, workers.log, etc.).
# This must be absolute (use ${PWD}/..., not ./...) and must already exist, or
# containers won't start. In production, put it outside the checkout and
# rotate the logs.
CONTAINER_LOG_DIR=${PWD}/logs

##
# Public URLs: the URLs your browser uses, not the stack's internal ones
##

# The pieces of NCA's URL. If you browse from another machine (e.g., NCA runs
# on a VM), set PUBLIC_HOST to the name or IP you browse to.
#
# In dev, the browser talks straight to the stack, so compose.override.yml
# publishes NCA on PUBLIC_PORT. In production, PUBLIC_PORT is whatever the
# browser sees (e.g., 443 on the authenticating proxy), *not* the port the
# stack publishes.
PUBLIC_SCHEME=http
PUBLIC_HOST=localhost
PUBLIC_PORT=3333

# The port portion of NCA's URL, *including* the colon. Blank when the port is
# the scheme's default (80 for http, 443 for https), as it usually is in
# production. Compose can't work this out on its own, so set it by hand.
PUBLIC_PORT_SUFFIX=:${PUBLIC_PORT}

# Derived from the above; you shouldn't need to edit this. It's the stack's
# root URL: page images are served from ${PUBLIC_URL}/images/iiif.
PUBLIC_URL=${PUBLIC_SCHEME}://${PUBLIC_HOST}${PUBLIC_PORT_SUFFIX}

# NCA's path under PUBLIC_URL, if it isn't at the root: a leading slash and no
# trailing slash (e.g., /nca). Only NCA moves; page images stay at
# /images/iiif. NCA builds its routes and links with this path, so the proxy
# in front of the stack must pass it through, not strip it.
NCA_URL_PATH=

# Local ONI stacks (local-dev profile), which compose.override.yml publishes
# on these ports. They only speak plain http.
ONI_PROD_PORT=8080
ONI_STAGING_PORT=8082
ONI_PROD_URL=http://${PUBLIC_HOST}:${ONI_PROD_PORT}
ONI_STAGING_URL=http://${PUBLIC_HOST}:${ONI_STAGING_PORT}

# The live newspaper site. NCA reads its issue data through JSON endpoints a
# vanilla ONI doesn't have (see "Services" in the docs), so even dev has to
# point at a real, patched site.
NEWS_WEBROOT=https://oregonnews.uoregon.edu

# The staging site, only used for links to batches awaiting QC. In dev this is
# the local staging ONI.
STAGING_NEWS_WEBROOT=${ONI_STAGING_URL}

##
# NCA
##

# Password for NCA's database user. The database isn't published by default,
# but use a real password in production anyway.
DB_PASSWORD=nca

# ONI Agents (host:port) NCA uses to load and purge batches. In dev these are
# the local-dev profile's agents.
STAGING_AGENT=oni-agent-staging:22
PRODUCTION_AGENT=oni-agent-prod:22

# MARC org code for batches built from born-digital (PDF) issues
PDF_BATCH_MARC_ORG_CODE=oru

# Batch sizes in pages. Test data is tiny, so dev needs a tiny minimum.
MIN_BATCH_SIZE=4
MAX_BATCH_SIZE=4000

# How long an upload has to sit untouched before it can be queued, and how
# long NCA flags it as new. Go durations, e.g., "30m", "48h".
#DURATION_ISSUE_CONSIDERED_DANGEROUS=48h
#DURATION_ISSUE_CONSIDERED_NEW=336h

# Debug mode: lets anybody act as any user, via a "debuguser" query parameter.
# Dev only. NEVER enable this in production!
NCA_DEBUG=true

# Version string baked into the NCA binaries when the image is built
#NCA_VERSION=v4.0.0

##
# SFTPGo
##

# SFTPGo's API, as NCA reaches it. Use "-" to turn off NCA's SFTPGo
# integration entirely.
SFTPGO_API_URL=http://sftpgo:8080/api/v2

# The API key NCA uses. This one only works with the dev seed below.
SFTPGO_ADMIN_API_KEY=ncadev.dev-only-sftpgo-key

# Dev only: seeds SFTPGo with an admin (login "admin", password "password")
# and the API key above. NEVER set this in production: anybody who's read
# this file knows both credentials. Without it, SFTPGo asks you to create an
# admin the first time you visit its web UI, and you create an API key there.
SFTPGO_LOADDATA_FROM=/etc/sftpgo/dev-data.json

# The host ports compose.override.yml publishes SFTPGo's web admin and SFTP
# server on
SFTPGO_WEB_PORT=8081
SFTPGO_SFTP_PORT=2022

##
# Caddy (the "proxy" service)
##

# Blank, or the word "debug" for verbose logging
#CADDY_DEBUG=debug

# Ranges whose X-Forwarded-For Caddy trusts, i.e., the proxy in front of the
# stack. Defaults to "static private_ranges".
#CADDY_TRUSTED_PROXIES=static 10.0.0.0/8
