#!/usr/bin/env bash
#
# Runs compose on the test stack, the way "podman compose" runs it on the dev
# stack: "test/stack/compose up -d", "test/stack/compose logs -f workers",
# and so on. It works from anywhere in the checkout.
#
# The test stack is configured entirely by the repository: compose.yml with
# test/stack/compose.yml in place of your override, and .env.example with
# test/stack/env's settings in place of its own. Your .env and shell don't
# change it, except for PUBLIC_HOST (see test/stack/env).
#
# Before it runs compose, this:
#
# - writes the test stack's env file, test/var/stack.env
# - unsets shell variables compose would use instead of the env file's
# - creates the host directories the stack's volumes and logs need
# - copies the dev stack's issue cache to start the test stack's, so NCA
#   doesn't spend ten minutes or more building one

set -euo pipefail

cd "$(dirname "$0")/../.."
export PWD

envfile=test/var/stack.env

# env_value prints a variable's value from a .env-style file: the last
# assignment wins, as in compose, and quotes and inline comments are dropped
env_value() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=//p" "$2" | tail -n 1 |
    sed 's/[[:space:]]#.*//' | tr -d "\"'[:space:]"
}

# Read what we need from the dev setup before unsetting anything
host=localhost
dev_project=${COMPOSE_PROJECT_NAME:-}
if [[ -f .env ]]; then
  host=$(env_value PUBLIC_HOST .env)
  host=${host:-localhost}
  dev_project=${dev_project:-$(env_value COMPOSE_PROJECT_NAME .env)}
fi
dev_project=${dev_project:-$(basename "$PWD")}

# The env file is .env.example with each of test/stack/env's settings
# replacing its own (or added at the end, if .env.example doesn't have it).
# It's written to a temporary file, then renamed, so another compose command
# running at the same time (e.g., "logs -f") never sees half a file.
mkdir -p test/var
tmpenv=$(mktemp "$envfile.XXXXXX")
{
  echo "# Generated by test/stack/compose from .env.example and test/stack/env."
  echo "# Don't edit: it's rewritten every time."
  echo
  awk -v host="$host" '
    FNR == NR {
      if (match($0, /^[A-Za-z_][A-Za-z0-9_]*=/)) {
        key = substr($0, 1, RLENGTH - 1)
        if (!(key in test)) order[++n] = key
        test[key] = $0
      }
      next
    }
    match($0, /^[A-Za-z_][A-Za-z0-9_]*=/) {
      key = substr($0, 1, RLENGTH - 1)
      if (key == "PUBLIC_HOST") { print "PUBLIC_HOST=" host; next }
      if (key in test) { print test[key]; used[key] = 1; next }
    }
    { print }
    END {
      for (i = 1; i <= n; i++) if (!(order[i] in used)) print test[order[i]]
    }
  ' test/stack/env .env.example
} >"$tmpenv"
chmod 644 "$tmpenv"
mv -f "$tmpenv" "$envfile"

# Compose prefers the shell's variables to the env file's, so anything the
# env file sets or the compose files read has to go, except PWD, which is
# the checkout
while read -r var; do
  if [[ $var != PWD ]]; then
    unset "$var"
  fi
done < <(
  sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$envfile"
  grep -ohE '\$\{[A-Za-z_][A-Za-z0-9_]*' compose.yml test/stack/compose.yml | cut -c3-
  compgen -e | grep '^COMPOSE_' || true
)

# Bind mounts need their directories (see test/stack/compose.yml), and
# containers won't start without their log directory (CONTAINER_LOG_DIR)
cache=test/var/issue-cache
mkdir -p test/fakemount/production-batches "$cache" test/var/logs

# The first time, the issue cache starts as a copy of the dev stack's, minus
# its finder cache, which describes the dev stack's workflow tree. The dev
# cache is wherever its volume points: a host directory if it's a bind mount
# (as in compose.override.example.yml), else podman's own storage.
if [[ -z $(ls -A "$cache") ]]; then
  from=$(podman volume inspect --format '{{index .Options "o"}}|{{index .Options "device"}}|{{.Mountpoint}}' \
    "${dev_project}_issue-cache" 2>/dev/null || true)
  case $from in
    "") ;;
    *bind*) from=$(cut -d'|' -f2 <<<"$from") ;;
    *) from=$(cut -d'|' -f3 <<<"$from") ;;
  esac
  if [[ -n $from && -n $(ls -A "$from" 2>/dev/null) ]]; then
    echo "Copying the dev stack's issue cache ($from) to start the test stack's" >&2
    tar -C "$from" --exclude=finder.cache -cf - . | tar -C "$cache" -xf -
  fi
fi

export PODMAN_COMPOSE_WARNING_LOGS=${PODMAN_COMPOSE_WARNING_LOGS:-false}
exec podman compose --env-file "$envfile" -f compose.yml -f test/stack/compose.yml "$@"
